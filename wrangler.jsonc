{
  "name": "xyz-project-hub",
  "main": "dist-server/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xyz-hub",
      "database_id": "local-dev"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "xyz-hub-files"
    }
  ],
  "vars": {
    "APP_ENV": "development"
  }
}
